# ---------- Grafo ----------
GRAPH_BACKEND=neo4j            # neo4j | memory (demonstração sem Docker)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphrag2026
NEO4J_DATABASE=neo4j

# ---------- LLM (qualquer API compatível com OpenAI) ----------
# none = modo offline determinístico (regras + gerador extrativo)
LLM_PROVIDER=none
# OpenAI:
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# Ollama local (gratuito):  ollama pull llama3.1:8b
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1:8b
# Groq (gratuito com limite):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# ---------- Embeddings ----------
EMBEDDING_PROVIDER=hash        # hash (offline) | openai | sentence-transformers
EMBEDDING_DIM=384
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536
# Ollama: EMBEDDING_PROVIDER=openai, EMBEDDING_BASE_URL=http://localhost:11434/v1,
#         EMBEDDING_MODEL=nomic-embed-text, EMBEDDING_DIM=768
# Local:  EMBEDDING_PROVIDER=sentence-transformers,
#         EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2, EMBEDDING_DIM=384

# ---------- Pipeline ----------
SCHEMA_MODE=strict             # strict | dynamic (aceita novos tipos de relação)
EXTRACTOR=auto                 # auto | llm | rules
TOP_K=5
MAX_HOPS=2
ABSTAIN_THRESHOLD=0.35
